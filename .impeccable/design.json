      "css": ".ds-allocation{background:#fff;padding:24px;border-radius:20px;font-family:Manrope,system-ui,sans-serif;color:var(--text,#20272c)}.ds-allocation h3{margin:0;font-size:1rem;letter-spacing:-.03em}.ds-bar{display:flex;gap:4px;height:22px;overflow:hidden;border-radius:6px;background:#edf1f6;margin:26px 0 20px}.ds-bar span{border-radius:4px}.ds-bar span:nth-child(1){width:40%;background:#648cc7}.ds-bar span:nth-child(2){width:25%;background:#c5a176}.ds-bar span:nth-child(3){width:35%;background:#75a48b}.ds-allocation p{font-size:.75rem;color:#54616a}"
