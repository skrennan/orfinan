    }
  ],
  "narrative": {
    "northStar": "Mesa financeira clara",
    "overview": "Uma área de trabalho pessoal, calma e legível. O sistema organiza o mês com superfícies claras, uma única família tipográfica e contrastes entre informação principal e detalhes. O nome descreve o resultado implementado; não representa uma preferência verbal adicional confirmada pelo usuário.\n\nA aparência genérica anterior foi rejeitada. A identidade atual vem da hierarquia do dinheiro, das áreas pastéis e da distribuição horizontal dos compromissos, sem depender de fotografias ou ornamentos.",
    "keyCharacteristics": [
      "Superfícies claras e cores sólidas.",
      "Manrope local e números alinháveis.",
      "Azul para ações; pastéis para resumo financeiro.",
      "Navegação lateral no computador e inferior no celular."
    ],
    "rules": [
      {
        "name": "The Financial Meaning Rule",
        "body": "Despesas normais usam tinta ou caramelo. Vermelho indica déficit, atraso, erro ou ação destrutiva; não colore automaticamente toda saída de dinheiro.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Painéis de dados ficam planos; a elevação distingue navegação flutuante e sobreposição.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preservar os significados financeiros das cores.",
      "Do usar números tabulares e valores reais nos resumos e na distribuição.",
      "Do manter foco visível, texto explicativo e rótulos em português.",
      "Do adaptar colunas e navegação aos pontos de quebra implementados."
    ],
    "donts": [
      "Don't usar vermelho para toda despesa.",
      "Don't aplicar gradientes ou sombras em todos os painéis.",
      "Don't adicionar fontes decorativas ou imagens sem função no controle financeiro.",
      "Don't substituir a distribuição real por percentuais ilustrativos."
    ]
  }
}
